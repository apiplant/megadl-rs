# Maintainer: apiplant <releases@apiplant.com>
#
# Built by the release workflow, which fills in the version and checksum and
# publishes the resulting package to apiplant.github.io/pacman. It is not an
# AUR manifest: the package is named `megadl-rs` rather than `megadl-rs-bin`
# and carries no `provides`/`conflicts` pair.
pkgname=megadl-rs
pkgver=@VERSION@
pkgrel=1
pkgdesc="Command-line downloader and terminal download manager for mega.nz links"
arch=('x86_64')
url="https://github.com/apiplant/megadl-rs"
license=('MIT')
depends=()
# The release archive holding both binaries and the README. The workflow
# builds the package before the release exists and drops the archive next to
# this file, which makepkg picks up instead of downloading; the URL is what
# makes the PKGBUILD work on its own once the release is published.
source=("$pkgname-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/megadl-rs-v$pkgver-x86_64-unknown-linux-gnu.tar.gz")
sha256sums=('@SHA_LINUX_X86_64@')
# The release profile already strips symbols, and makepkg's strip pass on an
# LTO'd binary buys nothing.
options=('!strip' '!debug')

package() {
  local src="$srcdir/megadl-rs-v$pkgver-x86_64-unknown-linux-gnu"
  install -Dm755 "$src/megadl" "$pkgdir/usr/bin/megadl"
  install -Dm755 "$src/megadl-tui" "$pkgdir/usr/bin/megadl-tui"
  install -Dm644 "$src/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
